{
    "name": "imu-lib",
    "version": "1.1.0",
    "description": "IMU library for ESP32 (MPU6050 / MPU9250) on ESP-IDF",
    "keywords": ["imu", "mpu9250", "mpu6050", "esp32", "esp-idf", "drone"],
    "repository": {
        "type": "git",
        "url": "https://github.com/Aerisys/imu-lib.git"
    },
    "authors": [
        {
            "name": "Aerisys",
            "email": "contact@aerisys.fr",
            "maintainer": true
        }
    ],
    "dependencies": {},
    "frameworks": ["espidf"],
    "platforms": ["espressif32"],
    "export": {
        "include": [
            "src/*.cpp",
            "include/*.h",
            "library.json",
            "LICENCE",
            "README*"
        ],
        "exclude": [
            "examples",
            "test",
            "lib",
            "platformio.ini",
            "CMakeLists.txt",
            "src/CMakeLists.txt",
            "sdkconfig*"
        ]
    },
    "build": {
        "srcFilter": [
            "+<*.cpp>"
        ],
        "includeDir": "include"
    }
}
